# Database (PostgreSQL via Supabase or local)
DATABASE_URL=postgresql://user:password@localhost:5432/inkomoko

# JWT Authentication
JWT_SECRET=<generate-a-random-secret-here>
JWT_EXPIRES_IN=30d

# Server
PORT=3000
NODE_ENV=development

# Email (Optional - for OTP verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=<your-gmail-app-password>
EMAIL_FROM="Inkomoko" <no-reply@inkomoko.app>

# AI (Optional - for story enhancement)
GEMINI_API_KEY=<your-gemini-api-key>

# File Upload
MAX_FILE_SIZE=52428800

# Maintenance (for database wipe endpoint)
WIPE_SECRET=<generate-a-random-secret-here>

# Frontend (for CORS)
FRONTEND_URL=http://localhost:3000
